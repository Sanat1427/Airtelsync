# Udyam One — Root Environment Configuration Example
# Copy to backend/.env and frontend/.env as needed

# Backend Server
PORT=5000
NODE_ENV=development

# MongoDB Connection (automatically falls back to local MongoDB 8.3 instance if not running)
MONGODB_URI=mongodb://127.0.0.1:27017/udyam_one

# JWT Authentication Secret
JWT_SECRET=udyam_one_enterprise_secret_key_change_in_prod_2026
JWT_EXPIRES_IN=7d

# Optional LLM / Vision API Key (Google Gemini)
# If omitted or empty, Udyam One uses its deterministic Catalogue-Grounded AI Advisor & Vision OCR engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Dataset Reference Date (Per Hackathon Specification: 15 July 2026)
DATASET_REFERENCE_DATE=2026-07-15
ADDRESS_PROOF_MAX_AGE_DAYS=90

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
